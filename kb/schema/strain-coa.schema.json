{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://terpedia.com/schemas/strain-coa.json",
  "title": "StrainCOARecord",
  "description": "Curated terpene (and optional cannabinoid) COA-style data associated with a cannabis strain. Intended for KB / RAG; operational lab data lives in TerpTender/Firestore.",
  "type": "object",
  "required": ["strain_id", "strain_names", "coa_entries"],
  "properties": {
    "strain_id": {
      "type": "string",
      "description": "Stable slug, lowercase kebab-case",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "strain_names": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "minItems": 1,
      "description": "Display names; first is primary"
    },
    "aliases": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Alternate spellings or market names"
    },
    "species": {
      "type": "string",
      "enum": ["indica", "sativa", "hybrid", "unknown"]
    },
    "lineage_notes": { "type": "string" },
    "coa_entries": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/coaEntry" }
    },
    "last_reviewed": { "type": "string", "format": "date" },
    "kb_version": { "type": "integer", "minimum": 1 }
  },
  "$defs": {
    "analyte": {
      "type": "object",
      "required": ["analyte"],
      "properties": {
        "analyte": { "type": "string", "description": "Canonical or lab label" },
        "canonical": { "type": "string", "description": "Normalized name (e.g. terptender normalization)" },
        "value": { "type": "number" },
        "unit": { "type": "string", "description": "e.g. %, mg/g, ppm" },
        "loq": { "type": "number" },
        "lod": { "type": "number" },
        "below_loq": { "type": "boolean" },
        "method": { "type": "string", "description": "e.g. GC-MS, HPLC" },
        "note": { "type": "string" }
      }
    },
    "coaEntry": {
      "type": "object",
      "required": ["entry_id", "source_type", "terpenes"],
      "properties": {
        "entry_id": { "type": "string" },
        "title": { "type": "string" },
        "source_type": {
          "type": "string",
          "enum": [
            "single_lab_coa",
            "lab_aggregate",
            "literature",
            "market_aggregate",
            "estimated",
            "placeholder"
          ],
          "description": "How to treat provenance; single_lab_coa should cite lab + sample when possible"
        },
        "citation": { "type": "string", "description": "URL, DOI, or internal ref" },
        "lab_name": { "type": "string" },
        "sample_id": { "type": "string" },
        "batch_id": { "type": "string" },
        "collected_at": { "type": "string", "description": "ISO date" },
        "instrument_method": { "type": "string" },
        "terpenes": {
          "type": "array",
          "items": { "$ref": "#/$defs/analyte" }
        },
        "cannabinoids": {
          "type": "array",
          "items": { "$ref": "#/$defs/analyte" }
        },
        "disclaimer": { "type": "string" }
      }
    }
  }
}
